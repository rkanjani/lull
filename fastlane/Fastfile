# Releases the current commit to both stores, one lane per platform:
#   ios release      builds, uploads to App Store Connect and submits for review (.github/workflows/app-store.yml)
#   android release  builds, uploads to Google Play and releases to production (.github/workflows/play-store.yml)
# Both run on every push to main. One-time setup: docs/RELEASING.md.

require "base64"
require "tmpdir"

default_platform(:ios)

BUNDLE_ID = "com.rohankanjani.lull"
# Each target that is signed, with its bundle identifier. The widgets and the watch app ship inside the app, and the
# watch face complications inside the watch app.
SIGNED_TARGETS = {
  "Lull" => BUNDLE_ID,
  "LullWidgets" => "#{BUNDLE_ID}.widgets",
  "LullWatch" => "#{BUNDLE_ID}.watchkitapp",
  "LullWatchWidgets" => "#{BUNDLE_ID}.watchkitapp.widgets"
}
TEAM_ID = "7786XZ3V4B"
PROJECT = "Lull.xcodeproj"
PACKAGE_NAME = "com.rohankanjani.lull"

# Reads a build setting of the app target. `sh` runs from the fastlane folder, hence the "../".
def build_setting(name)
  output = sh("xcodebuild", "-showBuildSettings", "-project", "../#{PROJECT}", "-target", "Lull", log: false)
  output[/^\s*#{name} = (.+)$/, 1].to_s.strip
end

platform :ios do
  desc "Build, upload and submit the current commit to App Store review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8")
    )

    version = build_setting("MARKETING_VERSION")
    live = Spaceship::ConnectAPI::App.find(BUNDLE_ID).get_live_app_store_version&.version_string
    if live && Gem::Version.new(version) <= Gem::Version.new(live)
      # A version that is already live can't be submitted again, so wait for MARKETING_VERSION to be raised.
      UI.important("#{version} is already on the App Store. Raise MARKETING_VERSION to submit a new release.")
      # Straight to stdout: fastlane's own `puts` adds a timestamp, which hides the annotation from GitHub.
      $stdout.puts "::notice title=Nothing submitted::#{version} is already on the App Store. Raise MARKETING_VERSION to release."
      next
    end

    uploaded = latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID, version: version, initial_build_number: 0)
    build = [uploaded.to_i, build_setting("CURRENT_PROJECT_VERSION").to_i].max + 1

    # Sign with the Apple Distribution certificate from the secrets, in a throwaway keychain.
    setup_ci
    certificate = File.join(Dir.mktmpdir, "distribution.p12")
    File.binwrite(certificate, Base64.decode64(ENV.fetch("DIST_CERT_P12_BASE64")))
    import_certificate(
      certificate_path: certificate,
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
    profiles = SIGNED_TARGETS.to_h do |target, bundle_id|
      get_provisioning_profile(api_key: api_key, app_identifier: bundle_id, team_id: TEAM_ID)
      profile = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        path: PROJECT,
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile
      )
      [bundle_id, profile]
    end

    build_app(
      project: PROJECT,
      scheme: "Lull",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      # The widgets and the watch app must carry the app's version, and only the app's is raised in Xcode.
      xcargs: "CURRENT_PROJECT_VERSION=#{build} MARKETING_VERSION=#{version}",
      output_directory: "build",
      clean: true
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      app_version: version,
      skip_screenshots: true,
      # Pulls a version still waiting for review so this newer build replaces it.
      reject_if_possible: true,
      submit_for_review: true,
      automatic_release: true,
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false },
      force: true
    )
  end
end

platform :android do
  desc "Build the current commit and release it on Google Play"
  lane :release do
    json_key = ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON")
    track = ENV.fetch("PLAY_TRACK", "production")
    # Both apps share MARKETING_VERSION; android/app/build.gradle.kts reads it from the Xcode project too.
    version = File.read("../#{PROJECT}/project.pbxproj")[/MARKETING_VERSION = ([0-9.]+);/, 1]

    # The phone app and the watch app go out on tracks of their own, and each is checked, so a re-run finishes a
    # release where only one went through. The Wear OS track may not be readable before Wear OS is added to the app in
    # Play Console; that counts as not released, as with the version codes below.
    phone_released = google_play_track_release_names(package_name: PACKAGE_NAME, track: track, json_key_data: json_key).include?(version)
    watch_released = begin
      google_play_track_release_names(package_name: PACKAGE_NAME, track: "wear:#{track}", json_key_data: json_key).include?(version)
    rescue StandardError => error
      # Said, so a failure for another reason, which would release the watch app again, isn't missed.
      UI.important("Couldn't read the Wear OS track, so the watch app counts as not released: #{error.message}")
      false
    end
    if phone_released && watch_released
      UI.important("#{version} is already on Google Play. Raise MARKETING_VERSION to release.")
      # Straight to stdout: fastlane's own `puts` adds a timestamp, which hides the annotation from GitHub.
      $stdout.puts "::notice title=Nothing released::#{version} is already on Google Play. Raise MARKETING_VERSION to release."
      next
    end

    # Version codes must only ever go up, across every track, the watch's included.
    tracks = %w[production beta alpha internal]
    codes = (tracks + tracks.map { |name| "wear:#{name}" }).flat_map do |name|
      google_play_track_version_codes(package_name: PACKAGE_NAME, track: name, json_key_data: json_key)
    rescue StandardError
      []
    end
    code = (codes.map(&:to_i).max || 0) + 1

    # Signing comes from LULL_UPLOAD_* in the environment; see android/app/build.gradle.kts. This builds the phone
    # app's bundle with this code and the watch app's with the next; only what isn't released yet is uploaded.
    gradle(project_dir: "android", task: "bundle", build_type: "Release", properties: { "versionCode" => code })
    bundles = lane_context[SharedValues::GRADLE_ALL_AAB_OUTPUT_PATHS]
    # Told apart by module, from the end of the path, wherever the repository is checked out.
    phone = bundles.find { |path| path.include?("/android/app/build/") }
    watch = bundles.find { |path| path.include?("/android/wear/build/") }

    unless phone_released
      upload_to_play_store(
        package_name: PACKAGE_NAME,
        json_key_data: json_key,
        track: track,
        aab: phone,
        version_name: version,
        # A brand-new app only accepts draft releases until its first one is sent for review in Play Console.
        release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
        metadata_path: "fastlane/metadata/android",
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end

    # The watch app goes out on the Wear OS track of the same release, once Wear OS is added to the app in Play
    # Console (docs/RELEASING.md). The listing is the phone's, uploaded with it.
    unless watch_released
      upload_to_play_store(
        package_name: PACKAGE_NAME,
        json_key_data: json_key,
        track: "wear:#{track}",
        aab: watch,
        version_name: version,
        release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
        skip_upload_metadata: true,
        skip_upload_changelogs: false,
        metadata_path: "fastlane/metadata/android",
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end
end
