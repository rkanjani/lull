<?xml version="1.0" encoding="utf-8"?>
<!-- Time left in a widget, counted down by the system so it keeps going while Lull is closed. Glance has no timer of
     its own, so this one is a classic view, placed with AndroidRemoteViews. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:countDown="true"
    android:fontFeatureSettings="tnum"
    android:singleLine="true"
    android:textColor="#FFFFFFFF"
    android:textStyle="bold" />
