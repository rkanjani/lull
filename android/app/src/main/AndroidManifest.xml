<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth only: Lull finds, talks to and hands over the BedJet. It never uses location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Shows a running BedJet as a Live Update in the status bar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Lull"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lull">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Widgets and tiles open a tab: lull://remote, lull://schedule or lull://history. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="lull" />
            </intent-filter>
        </activity>

        <!-- Home Screen widgets. Like the iPhone app's, they read what the app last saved. -->
        <receiver
            android:name=".widgets.TonightWidgetReceiver"
            android:exported="true"
            android:label="Tonight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tonight_widget" />
        </receiver>
        <receiver
            android:name=".widgets.LastNightWidgetReceiver"
            android:exported="true"
            android:label="Last Night">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/last_night_widget" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetTickReceiver"
            android:exported="false" />
        <receiver
            android:name=".LiveNotificationReceiver"
            android:exported="false" />

        <!-- Quick Settings tiles, the counterpart of the iPhone app's Control Center controls. -->
        <service
            android:name=".widgets.StartNightTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_night"
            android:label="Start Night"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".widgets.RemoteTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_remote"
            android:label="BedJet Remote"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
